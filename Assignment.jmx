          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Assertion" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

def response = prev.getResponseDataAsString()
def json = new JsonSlurper().parseText(response)

// Validate Category ID
if (!json.CategoryId || json.CategoryId.toString() != vars.get(&quot;CategoryId&quot;)) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Category ID mismatch&quot;)
}

// Validate CanRelist = true
if (json.CanRelist != true) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;CanRelist is not true&quot;)
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Printing" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import java.io.File

def response = prev.getResponseDataAsString()
def json = new JsonSlurper().parseText(response)

def file = new File(&quot;output.csv&quot;)

if (!file.exists()) {
    file.write(&quot;CategoryId,Name,Path,PromotionID,Price\n&quot;)
}

def categoryId = json.CategoryId
def name = json.Name
def path = json.Path

json.Promotions?.each { promo -&gt;
    def promoId = promo.Id
    def price = promo.Price ?: &quot;&quot;

    file.append(&quot;${categoryId},\&quot;${name}\&quot;,\&quot;${path}\&quot;,${promoId},${price}\n&quot;)
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
